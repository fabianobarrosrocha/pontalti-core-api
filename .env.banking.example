# Merge into the API environment. Never put these values in NEXT_PUBLIC_* variables.
# Start in Cora's test environment; stage confirmations do not create real Expenses.
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERT_PATH=/absolute/path/to/cora-certificate.pem
CORA_KEY_PATH=/absolute/path/to/cora-private-key.pem
# Alternative to paths: CORA_CERT_PEM and CORA_KEY_PEM with actual multiline PEM values.

# Both flags are required to submit. The worker also polls bank confirmations.
CORA_TRANSFERS_ENABLED=false
CORA_PAYROLL_WORKER_ENABLED=false

# Optional public HTTPS receiver. Keep empty while running only locally.
# Register once with npm run cora:webhook; --check lists registrations without creating one.
CORA_WEBHOOK_URL=

# Existing API authentication requires a strong PRIVATE_KEY in the main environment.
# The frontend must set AUTH_SECRET and may set CORE_API_URL=http://localhost:3001/api/v1.

# Customer balance integration: server-to-server only, >=32 random characters.
# Set the same private value in marketplace-frontend; never expose to the browser.
CUSTOMER_FINANCE_INTERNAL_TOKEN=
# Invoice issuance and read-only settlement polling are separate, explicit opt-ins.
CORA_CUSTOMER_DEPOSITS_ENABLED=false
CORA_CUSTOMER_DEPOSIT_WORKER_ENABLED=false
